<odoo>
    <record id="stock_picking_batch_form" model="ir.ui.view">
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock.stock_picking_batch_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_barcodes_review"
                    string="Review"
                    type="object"
                    class="oe_stat_button"
                    icon="checklist"
                    invisible="not barcodes_requested_review"
                />
            </div>
            <field name="user_id" position="after">
                <field name="barcodes_requested_review" />
            </field>
        </field>
    </record>
    <record id="stock_picking_batch_review_list" model="ir.ui.view">
        <field name="model">stock.picking.batch</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <list create="0">
                <field name="name" />
                <field name="scheduled_date" />
                <field name="picking_type_id" />
                <field name="state" widget="badge" />
                <button
                    name="action_barcodes_review"
                    type="object"
                    icon="checklist"
                    title="Review"
                    class="btn-primary"
                />
            </list>
        </field>
    </record>
    <record id="action_picking_batch_review" model="ir.actions.act_window">
        <field name="name">Batches to Review</field>
        <field name="res_model">stock.picking.batch</field>
        <field name="path">barcode-batch-review</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="stock_picking_batch_review_list" />
        <field
            name="domain"
        >[('barcodes_requested_review', '=', True), ('state', '=', 'in_progress')]</field>
    </record>
</odoo>
