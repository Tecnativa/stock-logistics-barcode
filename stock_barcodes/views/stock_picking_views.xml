<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_barcode_scan"
                    string="Scan"
                    type="object"
                    class="oe_stat_button"
                    icon="barcode"
                    invisible="state in ('done', 'cancel')"
                />
            </div>
        </field>
    </record>
    <record id="stock_picking_batch_form" model="ir.ui.view">
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock.stock_picking_batch_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_capture_open"
                    string="Scan"
                    type="object"
                    class="oe_stat_button"
                    icon="barcode"
                    invisible="state != 'in_progress'"
                />
            </div>
        </field>
    </record>
    <record id="view_picking_barcode_list" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <list create="0" default_order="scheduled_date, id">
                <field name="name" />
                <field name="partner_id" />
                <field name="scheduled_date" />
                <field name="origin" optional="show" />
                <field name="picking_type_id" optional="hide" />
                <field name="state" widget="badge" />
                <button
                    name="action_barcode_scan"
                    type="object"
                    icon="barcode"
                    title="Read barcodes"
                    class="btn-primary"
                />
            </list>
        </field>
    </record>
    <record id="action_picking_barcode" model="ir.actions.act_window">
        <field name="name">Transfers to Read</field>
        <field name="res_model">stock.picking</field>
        <field name="path">barcode-transfers</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_picking_barcode_list" />
        <field
            name="domain"
        >[('state', 'in', ('confirmed', 'waiting', 'assigned'))]</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>
</odoo>
