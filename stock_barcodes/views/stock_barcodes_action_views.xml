<odoo>
    <record id="stock_barcodes_action_view_list" model="ir.ui.view">
        <field name="model">stock.barcodes.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="icon" />
                <field name="barcode" />
                <field name="action_window_id" />
                <field name="method" optional="hide" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>
    <record id="stock_barcodes_action_view_form" model="ir.ui.view">
        <field name="model">stock.barcodes.action</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="icon" />
                            <field name="barcode" />
                            <field name="barcode_image" widget="image" />
                        </group>
                        <group>
                            <field name="action_window_id" />
                            <field name="context" />
                            <field name="method" />
                            <field name="count_model" />
                            <field name="domain" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_stock_barcodes_action" model="ir.actions.act_window">
        <field name="name">Barcode Actions</field>
        <field name="res_model">stock.barcodes.action</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_stock_barcodes_print" model="ir.actions.server">
        <field name="name">Print barcodes</field>
        <field name="model_id" ref="model_stock_barcodes_action" />
        <field name="binding_model_id" ref="model_stock_barcodes_action" />
        <field name="state">code</field>
        <field name="code">action = records.print_barcodes()</field>
    </record>
    <record id="action_stock_barcodes_main_menu" model="ir.actions.client">
        <field name="name">Barcodes</field>
        <field name="tag">stock_barcodes_main_menu</field>
        <field name="path">barcodes</field>
    </record>
    <menuitem
        id="stock_barcodes_root"
        name="Barcodes"
        action="action_stock_barcodes_main_menu"
        web_icon="stock_barcodes,static/description/icon.png"
        groups="stock.group_stock_user"
        sequence="141"
    />
    <menuitem
        id="stock_barcodes_action_menu"
        action="action_stock_barcodes_action"
        parent="stock.menu_warehouse_config"
        sequence="101"
    />
    <record id="action_report_barcode_actions" model="ir.actions.report">
        <field name="name">Barcode Actions</field>
        <field name="model">stock.barcodes.action</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_barcodes.report_barcode_actions</field>
    </record>
    <template id="report_barcode_actions">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <div class="row">
                        <div
                            t-foreach="docs"
                            t-as="action"
                            class="col-6 text-center mb-4"
                        >
                            <h4 t-out="action.name" />
                            <img
                                t-if="action.barcode"
                                t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=600&amp;height=150' % action.barcode"
                                style="width: 100%;"
                                alt="Barcode"
                            />
                            <div t-out="action.barcode" />
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
